# Copy to `.env` at the repo root and fill in. `.env` is gitignored.
#
# Congress.gov API key — free, issued instantly at:
#   https://api.congress.gov/sign-up/
#
# Only needed to RE-RUN the two scripts that pull bill metadata:
#   investigations/acu-legislative-bench/analysis/pull_bill_dates.py
#   investigations/amazon-money-without-praise/analysis/pull_cosponsors.py
# Their outputs are already committed under each case's derived/, so the
# database build and every query in investigations/<case>/queries.sql work
# without this key.
CONGRESS_GOV_API_KEY=
